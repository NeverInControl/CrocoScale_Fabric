VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO mux
  CLASS CORE ;
  FOREIGN mux ;
  ORIGIN 0.000 0.000 ;
  SIZE 3.360 BY 3.780 ;
  SITE CoreSite ;
  SYMMETRY X Y ;
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal1 ;
        RECT 0.000 -0.220 3.360 0.220 ;
    END
  END VSS
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal1 ;
        RECT 0.000 3.560 3.360 4.000 ;
    END
  END VDD
